{
  "info": {
    "name": "RepLiT Backend — Phase 8 (Neighborhood Notifications)",
    "description": "Crowdsourced 300 m alert responses. Login captures {{accessToken}}; List Areas captures {{areaId}}. Respond (Ignore/Report) upserts neighborhood_notifications and stops further alerts; bad area -> 404; missing token -> 401.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "areaId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Login",
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"login 200\", function () { pm.response.to.have.status(200); });",
        "pm.collectionVariables.set(\"accessToken\", pm.response.json().access_token);"
      ] } } ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"citizen1@example.com\",\n  \"password\": \"Test1234!\"\n}" },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] }
      },
      "response": []
    },
    {
      "name": "List Areas",
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "var a = pm.response.json();",
        "if (Array.isArray(a) && a.length) { pm.collectionVariables.set(\"areaId\", a[0].id); }"
      ] } } ],
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
        "url": { "raw": "{{baseUrl}}/areas?active_only=true", "host": ["{{baseUrl}}"], "path": ["areas"], "query": [ { "key": "active_only", "value": "true" } ] }
      },
      "response": []
    },
    {
      "name": "Respond - Ignore",
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"respond ignore 200\", function () { pm.response.to.have.status(200); });",
        "pm.test(\"message echoes ignore\", function () { pm.expect(pm.response.json().message).to.include(\"ignore\"); });"
      ] } } ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"area_id\": \"{{areaId}}\",\n  \"response\": \"ignore\"\n}" },
        "url": { "raw": "{{baseUrl}}/notifications/respond", "host": ["{{baseUrl}}"], "path": ["notifications","respond"] }
      },
      "response": []
    },
    {
      "name": "Respond - Report (idempotent upsert)",
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"respond report 200\", function () { pm.response.to.have.status(200); });",
        "pm.test(\"message echoes report\", function () { pm.expect(pm.response.json().message).to.include(\"report\"); });"
      ] } } ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"area_id\": \"{{areaId}}\",\n  \"response\": \"report\"\n}" },
        "url": { "raw": "{{baseUrl}}/notifications/respond", "host": ["{{baseUrl}}"], "path": ["notifications","respond"] }
      },
      "response": []
    },
    {
      "name": "Respond - Area Not Found",
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"unknown area 404\", function () { pm.response.to.have.status(404); });",
        "pm.test(\"error is not_found\", function () { pm.expect(pm.response.json().error).to.eql(\"not_found\"); });"
      ] } } ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"area_id\": \"00000000-0000-0000-0000-000000000000\",\n  \"response\": \"ignore\"\n}" },
        "url": { "raw": "{{baseUrl}}/notifications/respond", "host": ["{{baseUrl}}"], "path": ["notifications","respond"] }
      },
      "response": []
    },
    {
      "name": "Respond - No Auth (401)",
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"missing token 401\", function () { pm.response.to.have.status(401); });"
      ] } } ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"area_id\": \"{{areaId}}\",\n  \"response\": \"ignore\"\n}" },
        "url": { "raw": "{{baseUrl}}/notifications/respond", "host": ["{{baseUrl}}"], "path": ["notifications","respond"] }
      },
      "response": []
    }
  ]
}