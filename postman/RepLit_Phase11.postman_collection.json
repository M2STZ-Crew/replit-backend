{
  "info": {
    "name": "RepLiT Backend — Phase 11 (AI Summaries — Claude Haiku)",
    "description": "Generate and list post-incident fire-out summaries. Login captures {{accessToken}}; List Resolved Incidents captures {{incidentId}}. Generate requires ANTHROPIC_API_KEY set, a sub-admin/admin token, and a resolved incident.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "incidentId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Login",
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"login 200\", function () { pm.response.to.have.status(200); });",
        "pm.collectionVariables.set(\"accessToken\", pm.response.json().access_token);"
      ] } } ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"citizen1@example.com\",\n  \"password\": \"Test1234!\"\n}" },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] }
      },
      "response": []
    },
    {
      "name": "List Resolved Incidents",
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "var a = pm.response.json();",
        "if (Array.isArray(a) && a.length) { pm.collectionVariables.set(\"incidentId\", a[0].id); }"
      ] } } ],
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
        "url": { "raw": "{{baseUrl}}/incidents?active_only=false&status=resolved", "host": ["{{baseUrl}}"], "path": ["incidents"], "query": [ { "key": "active_only", "value": "false" }, { "key": "status", "value": "resolved" } ] }
      },
      "response": []
    },
    {
      "name": "Generate Summary",
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"generate 200\", function () { pm.response.to.have.status(200); });",
        "pm.test(\"has summary + cost\", function () { var j = pm.response.json(); pm.expect(j.summary_text).to.be.a('string'); pm.expect(j).to.have.property('cost_usd'); });"
      ] } } ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
        "description": "sub-admin/admin only; incident must be resolved; ANTHROPIC_API_KEY required (else 503).",
        "url": { "raw": "{{baseUrl}}/incidents/{{incidentId}}/summary", "host": ["{{baseUrl}}"], "path": ["incidents","{{incidentId}}","summary"] }
      },
      "response": []
    },
    {
      "name": "List Summaries",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
        "url": { "raw": "{{baseUrl}}/incidents/{{incidentId}}/summaries", "host": ["{{baseUrl}}"], "path": ["incidents","{{incidentId}}","summaries"] }
      },
      "response": []
    }
  ]
}