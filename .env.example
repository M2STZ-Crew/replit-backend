# ============================================================
#  RepLiT Backend — Environment Variables (TEMPLATE)
#  Copy to .env and fill in real values:  Copy-Item .env.example .env
#  NEVER commit .env. Each build phase appends new variables here.
# ============================================================

# ---------- Phase 1: Core application ----------

# Deployment environment: "development" | "staging" | "production"
ENVIRONMENT=development

# Human-readable application name (shown in logs and /health output)
APP_NAME=RepLiT Backend

# Semantic version of the running build
APP_VERSION=0.1.0

# Uvicorn bind address/port for local development
HOST=0.0.0.0
PORT=8000

# Logging
#   LOG_LEVEL : DEBUG | INFO | WARNING | ERROR | CRITICAL
#   LOG_JSON  : true  -> structured JSON logs (use in staging/production)
#               false -> pretty console logs (use in development)
#   Leave LOG_JSON empty to auto-select (JSON when ENVIRONMENT != development).
LOG_LEVEL=INFO
LOG_JSON=false

# Comma-separated list of allowed CORS origins (web dashboard + Vite/React stub)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Phase 2: Supabase ----------
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Public anon key (safe for clients)
SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY, bypasses RLS. Never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy JWT secret (kept for fallback; Phase 3 validates via JWKS)
SUPABASE_JWT_SECRET=
# 20-char project reference id
SUPABASE_PROJECT_REF=
# Postgres connection string — use the Transaction pooler URI (port 6543) for the app
DATABASE_URL=

# ---------- Phase 3: Auth / Twilio ----------
# Expected JWT audience claim (Supabase default is "authenticated")
JWT_AUDIENCE=authenticated
# Optional DB pool tuning (defaults are fine for the build)
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Twilio Verify (phone OTP, +40%)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=


# ---------- Phase 4: KYC (Didit.me) + Email (Brevo) ----------

# Didit.me hosted National ID + selfie KYC (+50%). Without these the manual
# upload fallback (/verification/national-id/manual) still works.
DIDIT_API_KEY=
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_WORKFLOW_ID=
# Shared secret for HMAC-verifying the Didit decision webhook. Required for
# POST /verification/national-id/webhook — without it every callback is rejected.
DIDIT_WEBHOOK_SECRET=

# Brevo SMTP — email verification links (+10%)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=RepLiT
# Public base URL of THIS backend — used to build email verification links and
# the Didit callback. Must be reachable by the user's browser / by Didit.
PUBLIC_BASE_URL=http://localhost:8000

# ---------- Phase 5: Firebase Cloud Messaging (push) ----------
# Supply exactly one of the two. FCM_CREDENTIALS_FILE points at the service-account
# JSON on disk (local dev); FCM_CREDENTIALS_JSON holds the raw JSON on one line
# (deploys with no writable filesystem). Push is disabled if neither is set.
FCM_CREDENTIALS_FILE=
FCM_CREDENTIALS_JSON=

# ---------- Phase 6: Incident reporting limits ----------
# Photo is mandatory and capped at 5 MB (Section 3.3); video is optional.
REPORT_MAX_PHOTO_BYTES=5242880
REPORT_MAX_VIDEO_BYTES=1572864
# Device-GPS vs photo-EXIF-GPS distance (metres) that flags a report for
# Sub-Admin review (Section 3.1).
GPS_DISCREPANCY_THRESHOLD_M=100

# ---------- Progressive verification weights (Sections 2, 3.2, 3.3) ----------
# Must total 100. Changing these does not retroactively rescore existing users
# until their next verification event.
PHONE_VERIFICATION_PERCENT=40
ID_VERIFICATION_PERCENT=50
EMAIL_VERIFICATION_PERCENT=10

# ---------- Phase 11: Anthropic (Claude Haiku) text summarization ----------
# Text-only post-incident fire-out reports. No vision — v8 removed AI image analysis.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=1024