# ============================================================
#  RepLiT Backend — Environment Variables (TEMPLATE)
#  Copy to .env and fill in real values:  Copy-Item .env.example .env
#  NEVER commit .env. Each build phase appends new variables here.
# ============================================================

# ---------- Phase 1: Core application ----------

# Deployment environment: "development" | "staging" | "production"
ENVIRONMENT=development

# Human-readable application name (shown in logs and /health output)
APP_NAME=RepLiT Backend

# Semantic version of the running build
APP_VERSION=0.1.0

# Uvicorn bind address/port for local development
HOST=0.0.0.0
PORT=8000

# Logging
#   LOG_LEVEL : DEBUG | INFO | WARNING | ERROR | CRITICAL
#   LOG_JSON  : true  -> structured JSON logs (use in staging/production)
#               false -> pretty console logs (use in development)
#   Leave LOG_JSON empty to auto-select (JSON when ENVIRONMENT != development).
LOG_LEVEL=INFO
LOG_JSON=false

# Comma-separated list of allowed CORS origins (web dashboard + Vite/React stub)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Phase 2: Supabase ----------
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Public anon key (safe for clients)
SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY, bypasses RLS. Never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy JWT secret (kept for fallback; Phase 3 validates via JWKS)
SUPABASE_JWT_SECRET=
# 20-char project reference id
SUPABASE_PROJECT_REF=
# Postgres connection string — use the Transaction pooler URI (port 6543) for the app
DATABASE_URL=