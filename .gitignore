# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# ===== Virtual environments =====
.venv/
venv/
env/

# ===== Node =====
# Both the root (Supabase CLI, pinned in package.json) and admin-web/.
# package.json and package-lock.json ARE committed so `npm ci` is reproducible.
node_modules/
dist/

# ===== Environment / secrets (NEVER commit) =====
.env
.env.local
.env.*.local
*.pem
*.key
firebase-service-account.json
service-account*.json
# The name Google Cloud gives a downloaded key: <project>-firebase-adminsdk-<id>.json.
# One was found loose in the repo root; the two patterns above did not match it,
# and this repository is public.
*-firebase-adminsdk-*.json
*adminsdk*.json

# ===== uv =====
# NOTE: uv.lock IS committed for reproducible builds — do not ignore it.

