# Copy to .env (or .env.local) and adjust if your API isn't on localhost:8000.
VITE_API_BASE=http://localhost:8000

# Mapbox public token for the dark basemap. Without it both maps fall back
# to plain OpenStreetMap tiles.
VITE_MAPBOX_TOKEN=pk.your_token_here

# Where the Observer Console (observer-web) is served. The Admin Console is
# Admin-only (Master Context v10); an observer who signs in here is told to go
# there instead.
VITE_OBSERVER_URL=http://localhost:5174
